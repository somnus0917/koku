# The public DNS name pointing to this Tencent Cloud CVM.
KOKU_DOMAIN=koku.somnus.wiki

# Relative paths are resolved from the directory containing compose.production.yml.
KOKU_DATA_DIR=./data

# Use `id -u` and `id -g` on the server. This lets the non-root API process
# write the bind-mounted SQLite directory without broad filesystem permissions.
KOKU_RUNTIME_UID=1000
KOKU_RUNTIME_GID=1000

# Bootstrap administrator email. Store the bcrypt password hash in
# KOKU_DATA_DIR/auth-password.hash with mode 600; never commit that file.
KOKU_AUTH_EMAIL=you@example.com
KOKU_SESSION_TTL_DAYS=30

# Recommended on Tencent Cloud; leave empty for local builds.
DEBIAN_MIRROR=http://mirrors.cloud.tencent.com

# --- Optional enhancements (see README) ---
# API rate limit per client per minute (0 disables). Default 300.
#KOKU_RATE_LIMIT_PER_MINUTE=300
# Scheduled backup interval in hours (0 disables). Default 24.
#KOKU_BACKUP_INTERVAL_HOURS=24
# Backups to keep before pruning old ones. Default 14.
#KOKU_BACKUP_KEEP=14
# Server-side recurring transaction and budget rollover check interval in minutes (1-1440).
#KOKU_JOBS_INTERVAL_MINUTES=60
# Market quote cache TTL in hours. Default 24.
#KOKU_QUOTE_TTL_HOURS=24
# Refresh recognized A-share, STAR, Hong Kong and US holdings once after each market close. Default true.
#KOKU_QUOTE_AUTO_REFRESH=true
# SMTP reminder digest: set KOKU_SMTP_HOST to enable; each enabled user's email
# receives only reminders from that user's independent ledger.
#KOKU_SMTP_HOST=smtp.example.com
#KOKU_SMTP_PORT=587
#KOKU_SMTP_TLS=starttls
#KOKU_SMTP_USERNAME=
#KOKU_SMTP_PASSWORD=
#KOKU_SMTP_FROM=koku@example.com
#KOKU_SMTP_INTERVAL_HOURS=24

# Cloudflare R2 off-site backup (optional): set KOKU_R2_ACCOUNT_ID to enable.
# Create an R2 API token with "Object Read & Write" permission; paste the S3
# Access Key ID / Secret Access Key pair below (never commit real secrets).
#KOKU_R2_ACCOUNT_ID=
#KOKU_R2_ACCESS_KEY_ID=
#KOKU_R2_SECRET_ACCESS_KEY=
#KOKU_R2_BUCKET=backups
#KOKU_R2_PREFIX=koku
