# The public DNS name pointing to this Tencent Cloud CVM.
KOKU_DOMAIN=money.example.com

# Relative paths are resolved from the directory containing compose.production.yml.
KOKU_DATA_DIR=./data

# Use `id -u` and `id -g` on the server. This lets the non-root API process
# write the bind-mounted SQLite directory without broad filesystem permissions.
KOKU_RUNTIME_UID=1000
KOKU_RUNTIME_GID=1000

# Single-user application login. Store the bcrypt password hash in
# KOKU_DATA_DIR/auth-password.hash with mode 600; never commit that file.
KOKU_AUTH_USERNAME=somnus
KOKU_SESSION_TTL_DAYS=30

# Recommended on Tencent Cloud; leave empty for local builds.
DEBIAN_MIRROR=http://mirrors.cloud.tencent.com

# --- Optional enhancements (see README) ---
# API rate limit per client per minute (0 disables). Default 300.
#KOKU_RATE_LIMIT_PER_MINUTE=300
# Scheduled backup interval in hours (0 disables). Default 0.
#KOKU_BACKUP_INTERVAL_HOURS=0
# Backups to keep before pruning old ones. Default 14.
#KOKU_BACKUP_KEEP=14
# Market quote cache TTL in hours. Default 24.
#KOKU_QUOTE_TTL_HOURS=24
# SMTP reminder digest: set KOKU_SMTP_HOST to enable; FROM/TO required then.
#KOKU_SMTP_HOST=smtp.example.com
#KOKU_SMTP_PORT=587
#KOKU_SMTP_TLS=starttls
#KOKU_SMTP_USERNAME=
#KOKU_SMTP_PASSWORD=
#KOKU_SMTP_FROM=koku@example.com
#KOKU_SMTP_TO=me@example.com
#KOKU_SMTP_INTERVAL_HOURS=24
