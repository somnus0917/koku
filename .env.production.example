# The public DNS name pointing to this Tencent Cloud CVM.
KOKU_DOMAIN=money.example.com

# Caddy protects the complete application, including every /api endpoint.
KOKU_AUTH_USER=koku
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'CHANGE_ME'
# Keep the bcrypt value single-quoted so Compose treats every $ literally.
KOKU_AUTH_HASH='$2a$14$replace_with_a_real_caddy_password_hash'

# Relative paths are resolved from the directory containing compose.production.yml.
KOKU_DATA_DIR=./data

# Use `id -u` and `id -g` on the server. This lets the non-root API process
# write the bind-mounted SQLite directory without broad filesystem permissions.
KOKU_RUNTIME_UID=1000
KOKU_RUNTIME_GID=1000
