# Add this block to the existing edge Caddy configuration on tencent-cloud.
# Replace the domain before reloading Caddy. Authentication is enforced by
# Koku itself, so the login page remains publicly reachable.
koku.example.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy koku-web:8080
}
