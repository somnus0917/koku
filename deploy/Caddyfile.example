# Add this block to the existing edge Caddy configuration on tencent-cloud.
# Authentication is enforced by Koku itself, so the login page remains publicly
# reachable. DNS for this name must point at the Tencent Cloud CVM before Caddy
# can obtain its certificate.
koku.somnus.wiki {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy koku-web:8080 {
		# 在离客户端最近、无法被伪造的这一跳，把 X-Forwarded-For 重置为
		# Caddy 实际看到的对端 IP（而不是默认的追加）。Koku 的登录限流
		# 信任该头的首段作为真实客户端 IP；若不重置，攻击者可在请求里
		# 自带伪造的 X-Forwarded-For 首段，每次换值即可绕过限流。
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
